<Page x:Class="Kirichenko_pr7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kirichenko_pr7.Pages"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
              Title="Web API" Height="450" Width="800" Background="BlanchedAlmond">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Margin="5" Background="White" BorderBrush="ForestGreen" FontStyle="Oblique" Width="200" BorderThickness="1" Foreground="ForestGreen">Добавить</Button>
            <Button Margin="5" Background="White" BorderBrush="Gold" FontStyle="Oblique" Width="200" BorderThickness="1" Foreground="Gold">Изменить</Button>
            <Button Margin="5" Background="White" BorderBrush="OrangeRed" FontStyle="Oblique" Width="200" BorderThickness="1" Foreground="OrangeRed">Удалить</Button>
        </StackPanel>
        <ListView HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" Margin="5" ItemsSource="{Binding pets}" >
            <ListView.ItemTemplate >
                <DataTemplate >
                    <Border Background="LightYellow"  BorderThickness="1">
                        <Grid Background="White" Margin="5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Id}" FontSize="15" Foreground="Gray" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Species}" FontSize="13" FontStyle="Italic" Foreground="#555555"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock FontSize="13" Margin="0,0,0,2">
                        <Run Text="Возраст: " Foreground="Gray"/>
                        <Run Text="{Binding Age}"/>
                                </TextBlock>
                                <TextBlock FontSize="13" Margin="0,0,0,2">
                        <Run Text="Вес: " Foreground="Gray"/>
                        <Run Text="{Binding Weight}"/>
                                </TextBlock>
                                <TextBlock FontSize="13">
                        <Run Text="Забрали: " Foreground="Gray"/>
                        <Run Text="{Binding IsAdopted}"/>
                                </TextBlock>
                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
    </Page>

