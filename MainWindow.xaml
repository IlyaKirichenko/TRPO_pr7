<Window x:Class="Kirichenko_pr7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kirichenko_pr7"
        mc:Ignorable="d"
        Title="Web API" Height="450" Width="800">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Margin="5" Background="White" BorderBrush="ForestGreen" FontStyle="Oblique" Width="200" BorderThickness="1" Foreground="ForestGreen">Добавить</Button>
            <Button Margin="5" Background="White" BorderBrush="Gold" FontStyle="Oblique" Width="200" BorderThickness="1" Foreground="Gold">Изменить</Button>
            <Button Margin="5" Background="White" BorderBrush="OrangeRed" FontStyle="Oblique" Width="200" BorderThickness="1" Foreground="OrangeRed">Удалить</Button>
        </StackPanel>
        <ListView HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" Margin="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            
                        </Grid.ColumnDefinitions>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
